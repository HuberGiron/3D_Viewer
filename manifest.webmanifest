{
  "id": "./",
  "name": "Visor 3D IBERO",
  "short_name": "Visor 3D",
  "description": "Abre, inspecciona y optimiza archivos STL en tu dispositivo.",
  "lang": "es-MX",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0c131f",
  "theme_color": "#101722",
  "icons": [
    {
      "src": "assets/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            ".stl",
            "model/stl",
            "application/sla",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
